# Database and authentication
DATABASE_URL=mongodb://localhost:27017/edunexa
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
CLIENT_URL=http://localhost:3000
FOLDER_NAME=Edunexa

# Brevo transactional email HTTPS API (works on Render Free)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=Edunexa <your-verified-sender@example.com>

# Other server integrations
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
RAZORPAY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-key-secret
